<!-- Importaciones de componentes de layout, controles y márgenes de JavaFX -->
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<!-- Contenedor raíz VBox centrado con espaciado de 20px vinculado al controlador secundario -->
<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ec.edu.com.SecondaryController">
    <!-- Controles hijos mostrados en la vista secundaria -->
    <children>
        <!-- Etiqueta identificadora de la vista secundaria -->
        <Label text="Secondary View" />
        <!-- Botón de retorno que dispara el método #switchToPrimary del controlador -->
        <Button fx:id="secondaryButton" text="Switch to Primary View" onAction="#switchToPrimary" />
    </children>
    <!-- Margen interno (padding) uniforme de 20px en todos los bordes del VBox -->
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
