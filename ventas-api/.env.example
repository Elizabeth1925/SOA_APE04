# ============================================================================
# CONFIGURACION DE BASE DE DATOS (MySQL)
# ============================================================================
# Direccion IP o host del servidor MySQL local o remoto
DB_HOST=127.0.0.1

# Puerto en el que escucha el servicio de MySQL (por defecto 3306)
DB_PORT=3306

# Nombre de la base de datos a utilizar para el sistema de ventas
DB_NAME=venta_vehiculos

# Usuario administrador o con privilegios sobre la base de datos
DB_USER=root

# Contrasena del usuario de la base de datos (vacia si no requiere)
DB_PASSWORD=

# ============================================================================
# CONFIGURACION DE LA API DE JAVA (Microservicio de Gestion de Vehiculos / Identidad)
# ============================================================================
# URL base donde corre la API en Java/Spring Boot
JAVA_URL=http://127.0.0.1:8080

# Clave secreta compartida con Java (propiedad app.security.ventas-key)
# Debe tener al menos 32 caracteres y no empezar con "COLOCA_"
VENTAS_SERVICE_KEY=COLOCA_LA_CLAVE_DE_app.security.ventas-key_DE_JAVA

# ============================================================================
# CONFIGURACION DEL SERVICIO DE NOTIFICACIONES
# ============================================================================
# URL base donde corre el microservicio de notificaciones
NOTIFICACIONES_URL=http://127.0.0.1:8081

# Clave secreta compartida con el servicio de notificaciones (propiedad app.notificacion-key)
# Debe tener al menos 32 caracteres y no empezar con "COLOCA_"
NOTIFICACIONES_KEY=COLOCA_LA_CLAVE_DE_app.notificacion-key_DE_JAVA
