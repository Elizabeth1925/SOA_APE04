# ============================================================================
# ARCHIVO: .env.example
# MICROSERVICIO: ventas-api (FastAPI, puerto :8002 detras de NGINX :8090)
# ============================================================================
# RESPONSABILIDAD EN LA ARQUITECTURA SOA:
#   Plantilla parametrizada de variables de entorno para desplegar y configurar
#   el microservicio de Compradores y Ventas sin exponer secretos reales en el
#   repositorio. Cada desarrollador o entorno debe copiar este archivo a `.env`
#   y completar las credenciales locales y claves compartidas de servicio.
#
# ACTIVIDADES APE 04 CUBIERTAS:
#   - [Actividad 1 / Actividad 2]: Parametrizacion externa de base de datos,
#     endpoints de integracion inter-servicios y secretos (factor Config de
#     12-Factor App) leidos por `app/config.py` y `app/db.py`.
#   - [Actividad 4]: Conexion hacia el API Gateway NGINX (:8090) / Spring Boot
#     para delegacion de identidad (`GET /api/identidad`) y reservas de vehiculos
#     mediante clave de servicio `VENTAS_SERVICE_KEY`.
#   - [Actividad 8]: Parametros de conexion al broker RabbitMQ y nombre de la
#     cola durable `notificaciones.ventas` para publicacion asincrona de eventos.
#   - [Actividad 11]: Facilita pruebas de fallo real (caida de MySQL, Java o
#     RabbitMQ) sin alterar codigo fuente.
# ============================================================================

# ============================================================================
# [Actividad 1 / Actividad 2] CONFIGURACION DE BASE DE DATOS (MySQL)
# ============================================================================
# Direccion IP o nombre de host del servidor MySQL compartido por el ecosistema SOA
DB_HOST=127.0.0.1
# Puerto TCP estandar donde escucha el motor relacional MySQL
DB_PORT=3306
# Nombre del esquema de base de datos que aloja las tablas `compradores` y `ventas`
DB_NAME=venta_vehiculos
# Usuario de conexion a MySQL utilizado por SQLAlchemy y Alembic
DB_USER=root
# Contrasena del usuario MySQL (dejar vacia solo si el entorno local no exige clave; colocar secreto real en `.env`)
DB_PASSWORD=

# ============================================================================
# [Actividad 1 / Actividad 2] [Actividad 4] CONFIGURACION DE LA API DE JAVA
# (Via NGINX :8090 como API Gateway o Instancia A de Spring Boot :8080)
# ============================================================================
# URL base hacia Java usada para validar JWT (`GET /api/identidad`) y gestionar reservas de vehiculos
JAVA_URL=http://127.0.0.1:8090
# Clave compartida (>= 32 caracteres) enviada en la cabecera `X-Service-Key` hacia Spring Boot (reemplazar en `.env`)
VENTAS_SERVICE_KEY=COLOCA_LA_CLAVE_DE_app.security.ventas-key_DE_JAVA

# ============================================================================
# [Actividad 1 / Actividad 2] CONFIGURACION DEL SERVICIO DE NOTIFICACIONES
# ============================================================================
# URL base del microservicio de notificaciones (:8081) conservada en la configuracion del entorno
NOTIFICACIONES_URL=http://127.0.0.1:8081
# Clave compartida (>= 32 caracteres) para autenticacion hacia el servicio de notificaciones (reemplazar en `.env`)
NOTIFICACIONES_KEY=COLOCA_LA_CLAVE_DE_app.notificacion-key_DE_JAVA

# ============================================================================
# [Actividad 8] CONFIGURACION DE RABBITMQ (MENSAJERIA ASINCRONA DURABLE - APE 04)
# ============================================================================
# Host o direccion IP del broker RabbitMQ utilizado por `rabbitmq_publisher.py`
RABBITMQ_HOST=127.0.0.1
# Puerto AMQP estandar del broker RabbitMQ (5672)
RABBITMQ_PORT=5672
# Usuario AMQP para autenticarse frente a RabbitMQ mediante `pika.PlainCredentials`
RABBITMQ_USER=guest
# Contrasena AMQP de placeholder (reemplazar por la clave local en `.env`, nunca versionar secretos reales)
RABBITMQ_PASSWORD=COLOCA_CLAVE_RABBITMQ_LOCAL
# Nombre de la cola durable donde se publican eventos persistentes de ventas completadas
RABBITMQ_QUEUE=notificaciones.ventas
