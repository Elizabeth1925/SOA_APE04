# ============================================================================
# CONFIGURACION DE BASE DE DATOS (MySQL)
# ============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=venta_vehiculos
DB_USER=root
DB_PASSWORD=

# ============================================================================
# CONFIGURACION DE LA API DE JAVA (Via NGINX :8090 o Instancia A :8080)
# ============================================================================
JAVA_URL=http://127.0.0.1:8090
VENTAS_SERVICE_KEY=COLOCA_LA_CLAVE_DE_app.security.ventas-key_DE_JAVA

# ============================================================================
# CONFIGURACION DEL SERVICIO DE NOTIFICACIONES
# ============================================================================
NOTIFICACIONES_URL=http://127.0.0.1:8081
NOTIFICACIONES_KEY=COLOCA_LA_CLAVE_DE_app.notificacion-key_DE_JAVA

# ============================================================================
# CONFIGURACION DE RABBITMQ (MENSAJERIA ASINCRONA DURABLE - APE 04)
# ============================================================================
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=COLOCA_CLAVE_RABBITMQ_LOCAL
RABBITMQ_QUEUE=notificaciones.ventas
