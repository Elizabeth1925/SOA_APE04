# Entornos virtuales de Python
.venv/

# Archivo de variables de entorno locales (contiene credenciales y secretos)
.env

# Archivos de cache compilados generados por Python
__pycache__/
*.py[cod]

# Carpetas de cache de herramientas de pruebas y analisis estatico
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Configuraciones locales de editores e IDEs (Visual Studio Code, JetBrains PyCharm)
.vscode/
.idea/
